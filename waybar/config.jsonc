{
  "layer": "top",
  "position": "top",
  "height": 0,
  "spacing": 0,

  "modules-left":   ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["mpris", "clock"],
  "modules-right":  [
    "cava", "idle_inhibitor", "privacy", "group/hardware",
    "backlight", "pulseaudio", "network", "bluetooth",
    "power-profiles-daemon", "battery", "custom/notification",
    "tray", "custom/power"
  ],

  "custom/launcher": {
    "format": "",
    "on-click": "nwg-drawer",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": { "default": "", "active": "󱓻", "urgent": "" }
  },

  "hyprland/window": {
    "separate-outputs": true,
    "max-length": 50,
    "rewrite": {
      "(.*) — Brave": "$1",
      "(.*) - Brave": "$1",
      "(.*) - Chromium": "$1",
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Outlook": "$1",
      "(.*) Microsoft Teams": "$1"
    }
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "player-icons": { "default": "▶", "spotify": "", "firefox": "" },
    "status-icons": { "paused": "⏸" },
    "dynamic-len": 40,
    "max-length": 45
  },

  "clock": {
    "interval": 1,
    "format": "{:%a %d %b   %H:%M:%S}",
    "format-alt": "{:%Y-%m-%d   %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#c6a0f6'><b>{}</b></span>",
        "days":     "<span color='#8aadf4'><b>{}</b></span>",
        "weeks":    "<span color='#a6da95'><b>W{}</b></span>",
        "weekdays": "<span color='#eed49f'><b>{}</b></span>",
        "today":    "<span background='#91d7e3' color='#24273a'><b><u>{}</u></b></span>"
      }
    },
    "actions": { "on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
  },

  "cava": {
    "framerate": 30,
    "autosens": 1,
    "bars": 12,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "method": "pipewire",
    "source": "auto",
    "stereo": true,
    "bar_delimiter": 0,
    "noise_reduction": 0.77,
    "input_delay": 2,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "actions": { "on-click-right": "mode" }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "", "deactivated": "" },
    "tooltip-format-activated": "Idle inhibitor on",
    "tooltip-format-deactivated": "Idle inhibitor off"
  },

  "privacy": {
    "icon-spacing": 6,
    "icon-size": 13,
    "transition-duration": 250,
    "modules": [
      { "type": "screenshare", "tooltip": true },
      { "type": "audio-in", "tooltip": true }
    ]
  },

  "group/hardware": {
    "orientation": "inherit",
    "drawer": { "transition-duration": 300, "children-class": "hw-child", "transition-left-to-right": false },
    "modules": ["custom/system", "disk", "memory", "cpu", "temperature"]
  },
  "custom/system": { "format": "", "tooltip": false },
  "disk":   { "format": " {percentage_used}%", "path": "/", "on-click": "alacritty -e btop" },
  "memory": { "format": " {}%", "on-click": "alacritty -e btop" },
  "cpu":    { "format": " {usage}%", "on-click": "alacritty -e btop" },
  "temperature": {
    "thermal-zone": 4,
    "critical-threshold": 80,
    "format": " {temperatureC}°C"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": { "headphones": "", "headset": "", "default": ["", "", ""] },
    "on-click": "alacritty --class=Wiremix -e wiremix",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  Wired",
    "format-disconnected": "⚠  Off",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname} ({ipaddr}/{cidr})",
    "on-click": "nmgui"
  },

  "bluetooth": {
    "format-on": "󰂰",
    "format-off": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂳 {num_connections}",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    "on-click": "alacritty --class=Bluetui -e bluetui"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "format-icons": { "default": "", "performance": "", "balanced": "", "power-saver": "" }
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["", "", "", "", ""]
  },

  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫", "none": "󰂜",
      "dnd-notification": "󰂠", "dnd-none": "󰪓",
      "inhibited-notification": "󰂛", "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout -p layer-shell",
    "tooltip": false
  }
}
